      "name": "Woow HA Permission Manager"
    },
    {
      "src": "ha_area_control",
      "domain": "ha_area_control",
      "repo": "WOOWTECH/hacs-ha_area_control",
      "name": "Woow HA Area Control"
    },
    {
      "src": "ha_label_control",
      "domain": "ha_label_control",
      "repo": "WOOWTECH/hacs-ha_label_control",
      "name": "Woow HA Label Control"
    }
  ]
}
